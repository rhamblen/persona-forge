{
  "id": "pose-face-pass",
  "name": "Pose face pass (FaceDetailer over a rendered pose)",
  "description": "Phase H3 pass 2: re-render only the face of an already-rendered pose, at native resolution, to put the emotion on it. Full-body sprites leave the face ~100px wide, which is both too small to carry a trained identity and too small to read an expression — FaceDetailer crops the detected face, diffuses it at guide_size, and pastes it back. Measured on the live box (docs/pose-control.md §4.0): denoise 0.60 produces a genuinely furious face with identity intact, 0.75 destroys it, 0.45 barely moves it. Needs an anime-capable checkpoint — base SDXL renders a flat face at every denoise. Runs against the stored pass-1 image, so re-rolling an expression never re-renders the body.",
  "file": "pose-face-pass.json",
  "output_node": "28",
  "lora_optional": { "node": "13", "fallback_source": ["1", 0] },
  "params": {
    "image":         { "node": "20", "input": "image",         "type": "text",  "label": "Base render (ComfyUI input path)" },
    "trigger":       { "node": "14", "input": "value",         "type": "text",  "label": "Trigger word" },
    "lora_name":     { "node": "13", "input": "lora_name",     "type": "model", "label": "Character LoRA", "model_type": "loras" },
    "lora_strength": { "node": "13", "input": "strength_model", "type": "float", "label": "LoRA strength", "min": 0.0, "max": 2.0, "step": 0.05 },
    "character":     { "node": "2",  "input": "value",         "type": "text",  "label": "Character", "multiline": true },
    "expression":    { "node": "5",  "input": "value",         "type": "text",  "label": "Expression", "multiline": true },
    "negative":      { "node": "4",  "input": "value",         "type": "text",  "label": "Negative", "multiline": true },
    "checkpoint":    { "node": "1",  "input": "ckpt_name",     "type": "model", "label": "Checkpoint", "model_type": "checkpoints" },
    "denoise":       { "node": "27", "input": "denoise",       "type": "float", "label": "Face denoise", "min": 0.1, "max": 1.0, "step": 0.05 },
    "guide_size":    { "node": "27", "input": "guide_size",    "type": "float", "label": "Face guide size", "min": 64, "max": 2048, "step": 8 },
    "steps":         { "node": "27", "input": "steps",         "type": "int",   "label": "Steps", "min": 1, "max": 80 },
    "cfg":           { "node": "27", "input": "cfg",           "type": "float", "label": "CFG", "min": 1.0, "max": 12.0, "step": 0.1 },
    "seed":          { "node": "27", "input": "seed",          "type": "int",   "label": "Seed" },
    "output_prefix": { "node": "28", "input": "filename_prefix", "type": "path", "label": "Output prefix" }
  }
}
