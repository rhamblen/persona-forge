{
  "ckpt": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "animi/NoobAI-XL-v1.1.safetensors" },
    "_meta": { "title": "Checkpoint" }
  },
  "load": {
    "class_type": "LoadImageDataSetFromFolder",
    "inputs": { "folder": "pf-dataset" },
    "_meta": { "title": "Training dataset (ComfyUI input subfolder)" }
  },
  "fl2": {
    "class_type": "Florence2ModelLoader",
    "inputs": { "model": "Florence-2-large", "precision": "bf16" },
    "_meta": { "title": "Florence-2 (captioner)" }
  },
  "cap": {
    "class_type": "Florence2Run",
    "inputs": {
      "image": ["load", 0],
      "florence2_model": ["fl2", 0],
      "text_input": "",
      "task": "caption",
      "fill_mask": false
    },
    "_meta": { "title": "Caption each image" }
  },
  "cat": {
    "class_type": "StringConcatenate",
    "inputs": { "string_a": "pf_char", "string_b": ["cap", 2], "delimiter": ", " },
    "_meta": { "title": "Prefix trigger word" }
  },
  "enc": {
    "class_type": "CLIPTextEncode",
    "inputs": { "clip": ["ckpt", 1], "text": ["cat", 0] },
    "_meta": { "title": "Encode per-image caption" }
  },
  "batch": {
    "class_type": "ImageListToImageBatch",
    "inputs": { "images": ["load", 0] }
  },
  "vae": {
    "class_type": "VAEEncode",
    "inputs": { "pixels": ["batch", 0], "vae": ["ckpt", 2] }
  },
  "train": {
    "class_type": "TrainLoraNode",
    "inputs": {
      "model": ["ckpt", 0],
      "latents": ["vae", 0],
      "positive": ["enc", 0],
      "batch_size": 1,
      "grad_accumulation_steps": 1,
      "steps": 500,
      "learning_rate": 0.0005,
      "rank": 16,
      "optimizer": "AdamW",
      "loss_function": "MSE",
      "seed": 0,
      "training_dtype": "bf16",
      "lora_dtype": "bf16",
      "quantized_backward": false,
      "algorithm": "LoRA",
      "gradient_checkpointing": true,
      "checkpoint_depth": 1,
      "offloading": true,
      "existing_lora": "[None]",
      "bucket_mode": false,
      "bypass_mode": false
    },
    "_meta": { "title": "Train LoRA" }
  },
  "save": {
    "class_type": "SaveLoRA",
    "inputs": { "lora": ["train", 0], "prefix": "pf-char/lora/pf-char", "steps": ["train", 2] },
    "_meta": { "title": "Save LoRA" }
  }
}
